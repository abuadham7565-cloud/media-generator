# انسخ هذا الملف إلى .env.local محليًا — ونفس القيم في Vercel → Settings → Environment Variables

# قاعدة Turso (إلزاميان) — أنشئها: turso db create <name> ثم turso db show <name> --url و turso db tokens create <name>
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# رابط خدمة دمج الفيديو (المشروع الثاني في مجلد merger/ بعد نشره على Vercel)
# مثال: https://video-merger-xxxx.vercel.app
MERGER_API_BASE=

# اختياري: إن ضُبط يُطلب Authorization: Bearer <token> على /mcp
# MCP_ACCESS_TOKEN=

# اختياري: تجاوز أسماء الموديلات إن لزم
# KIE_IMAGE_MODEL=
# KIE_VIDEO_MODEL=
# COMETAPI_IMAGE_MODEL=
# COMETAPI_VIDEO_MODEL=
